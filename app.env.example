# King of Meal Prep environment template. Never commit the populated file.
# Keep the populated file at runtime/app.env with mode 0600.
# Run scripts/init-local-env.py after installing the Python dependencies.

# --- auth ---
ADMIN_USER=admin
ADMIN_PASS_HASH=
SECRET_KEY=

# --- session ---
SESSION_INACTIVITY_HOURS=24
FORCE_HTTPS=false
TRUSTED_HOSTS=localhost,127.0.0.1

# --- secrets the user fills in via /settings ---
GEMINI_API_KEY=

# --- email (digest + reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=

# --- local development paths ---
DB_PATH=./runtime/data.db
NUTRITION_DB=./datasets/nutrition.db
APP_ENV_PATH=./runtime/app.env
ENV_MARKER_PATH=./runtime/.env-changed
DB_BACKUP_DIR=./runtime/backups
